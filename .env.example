# mock — MSW in the browser (default in development)
# real — Vite proxy to the Go API (see .env.real)
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
# Only used when VITE_API_MODE=real
VITE_API_PROXY_TARGET=http://localhost:8080
# Enable Yjs/Hocuspocus collaboration in real mode
VITE_COLLAB_ENABLED=false
